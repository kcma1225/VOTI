# Copy to .env and edit if needed; never commit secrets.
# docker compose 會在容器內把 CORPUS_DATA_DIR 固定為 /data（對應 ./data），並固定 ALLOWED_HOSTS 與 MAX_UPLOAD_MB。
CORPUS_DATA_DIR=./data
# 資料庫密碼（docker compose 用；預設 corpus，只在內部網路，不對外開放）：
# POSTGRES_PASSWORD=corpus
# 本機 venv 執行時連到 compose 的 db（需自行開放連接埠）或自備的 PostgreSQL：
# CORPUS_DATABASE_URL=postgresql://corpus:corpus@127.0.0.1:5432/corpus
YOUTUBE_API_KEY=
SPEAKER_DEVICE=cpu
MIN_SEGMENT_SEC=0.5
MAX_SEGMENT_SEC=30
EDGE_PADDING_SEC=0.12
# 只在本機 venv 執行網站時使用：
# ALLOWED_HOSTS=127.0.0.1,localhost
# MAX_UPLOAD_MB=2048
