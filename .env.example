# Copy to .env and edit. Never commit .env.

# ── Network ──────────────────────────────────────────────
# The TLS proxy (another LAN machine) forwards https://voti.gugulu.tw → http://<this host>:8080
BIND_ADDR=0.0.0.0
HTTP_PORT=8080
PUBLIC_HOSTS=voti.gugulu.tw

# ── Initial admin (used ONLY when the database has no users yet) ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Internal secrets (change before first start) ─────────
POSTGRES_PASSWORD=voti
S3_ACCESS_KEY=voti
S3_SECRET_KEY=voti-secret-change-me

# ── Compute ──────────────────────────────────────────────
# cpu | cu128 — use cu128 together with compose.gpu.yaml
TORCH_VARIANT=cpu
DEVICE=auto

# ── Models / APIs ────────────────────────────────────────
# Needed for pyannote/speaker-diarization-community-1 (accept the model terms on huggingface.co first)
HF_TOKEN=
# Optional: YouTube Data API v3 key
YOUTUBE_API_KEY=
